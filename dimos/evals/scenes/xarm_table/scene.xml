<mujoco model="xarm_table">
  <!-- World-only tabletop scene for sim2. The arm is attached by load_scene at
       the "workbench" spawn in scene.json, so there is no robot include here.
       (No "- -" digraphs in comments: ElementTree rejects them.) -->
  <!-- Elliptic friction cones with impratio 10 keep a gripped object from sliding
       out of the fingers under its own weight, as in the sim2 workbench scene. -->
  <option cone="elliptic" impratio="10"/>
  <statistic center="0.3 0 0.4" extent=".65"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.26 0.27 0.29 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.33 0.31 0.29" rgb2="0.28 0.26 0.25" markrgb="0.38 0.36 0.34"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="4 4"
      reflectance="0.05"/>
    <material name="wall" rgba="0.62 0.60 0.56 1"/>
    <material name="wall_back" rgba="0.42 0.46 0.50 1"/>
    <material name="ceiling" rgba="0.80 0.80 0.78 1"/>
    <material name="table_top" rgba="0.55 0.45 0.35 1"/>
    <material name="table_leg" rgba="0.4 0.35 0.3 1"/>
    <material name="apple_red" rgba="0.85 0.1 0.1 1"/>
    <material name="orange" rgba="1.0 0.55 0.0 1"/>
    <material name="cup_beige" rgba="0.9 0.85 0.75 1"/>
  </asset>

  <default>
    <!-- Graspable items: same contact parameters as the xarm_grasp_sim scene. -->
    <default class="obj">
      <geom friction="1.0 0.02 0.001" solimp="0.95 0.99 0.001" solref="0.004 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2.2" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="1.0 0.8 1.8" dir="-0.5 -0.4 -1" diffuse="0.35 0.35 0.35"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Enclosed room so the wrist camera sees walls past the table edge, not sky. -->
    <geom name="wall_back" type="box" size="0.05 2.0 1.3" pos="1.5 0 1.3" material="wall_back"/>
    <geom name="wall_front" type="box" size="0.05 2.0 1.3" pos="-1.1 0 1.3" material="wall"/>
    <geom name="wall_left" type="box" size="1.3 0.05 1.3" pos="0.2 1.5 1.3" material="wall"/>
    <geom name="wall_right" type="box" size="1.3 0.05 1.3" pos="0.2 -1.5 1.3" material="wall"/>
    <geom name="ceiling" type="box" size="1.3 2.0 0.05" pos="0.2 0 2.6" material="ceiling"/>

    <!-- Table ahead of the arm base: top at z=0.13, x 0.30..0.60, y -0.20..0.20. -->
    <geom name="table_top" type="box" size="0.15 0.20 0.01" pos="0.45 0 0.12" material="table_top"/>
    <geom name="table_leg1" type="cylinder" size="0.02 0.055" pos="0.32 -0.18 0.055" material="table_leg"/>
    <geom name="table_leg2" type="cylinder" size="0.02 0.055" pos="0.58 -0.18 0.055" material="table_leg"/>
    <geom name="table_leg3" type="cylinder" size="0.02 0.055" pos="0.32  0.18 0.055" material="table_leg"/>
    <geom name="table_leg4" type="cylinder" size="0.02 0.055" pos="0.58  0.18 0.055" material="table_leg"/>

    <!-- Free bodies resting on the table top (1 mm clearance). -->
    <body name="apple" pos="0.40 0.08 0.171">
      <freejoint/>
      <geom class="obj" type="sphere" size="0.04" material="apple_red" mass="0.15"/>
    </body>
    <body name="orange" pos="0.45 -0.08 0.176">
      <freejoint/>
      <geom class="obj" type="sphere" size="0.045" material="orange" mass="0.18"/>
    </body>
    <body name="cup" pos="0.50 0.0 0.191">
      <freejoint/>
      <geom class="obj" type="cylinder" size="0.035 0.06" material="cup_beige" mass="0.2"/>
    </body>
  </worldbody>
</mujoco>
